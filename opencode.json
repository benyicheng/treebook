{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "executor": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Executes plans with batch-first parallelism. Groups independent tasks, spawns all in parallel, and verifies each micro-task.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": {
          "git *": "allow",
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "tsx *": "allow",
          "vitest *": "allow",
          "*": "ask"
        },
        "task": "allow",
        "todowrite": "allow"
      }
    },
    "planner": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Creates micro-task plans optimized for parallel execution. Analyzes design docs, identifies independent work units, and produces one file per task with dependency ordering.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow"
      }
    },
    "reviewer": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Reviews ONE micro-task: verifies file + test match plan, test passes.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow"
      }
    },
    "implementer": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Executes ONE micro-task: creates one file + its test, runs verification.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow"
      }
    },
    "librarian": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Expert manager for project memory — storing and retrieving conventions, decisions, context, and session progress.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow",
        "memory-read": "allow",
        "memory-write": "allow",
        "memory-edit": "allow",
        "memory-delete": "allow",
        "memory-health": "allow"
      }
    }
  }
}
