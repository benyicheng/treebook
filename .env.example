DATABASE_URL="file:./dev.db"
PORT=3001
JWT_SECRET="change-me-to-a-long-random-secret"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选：首次初始化管理员所需的引导令牌。配置后，POST /api/init/setup 必须附带
# 请求头 x-bootstrap-token: <ADMIN_BOOTSTRAP_TOKEN> 才能创建首位管理员。
# 留空时退化为"仅允许在空库时初始化"（仍受事务保护，但无额外鉴权）。
ADMIN_BOOTSTRAP_TOKEN=""

# ── Feature Flags ────────────────────────────────────────────────────
# 事件卡六向连接器（Event Card Six-direction Connector）
# 开关 + 灰度百分比。flag 关闭时相关接口完全退回旧行为（零回归）。
# rolloutPercent 控制按 userId 稳定分桶的灰度比例（0-100）。
FEATURE_EVENT_CONNECTORS=false
FEATURE_EVENT_CONNECTORS_ROLLOUT_PERCENT=0

# 前端环境变量 (VITE_ 前缀会暴露到客户端)
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:3001
VITE_APP_URL=http://localhost:5173

# 前端 Feature Flag（与后端 FEATURE_EVENT_CONNECTORS 配对使用）
# 关闭时前端不调用 /events/connectors 接口、不渲染六向连接器 UI
# 开启时仍受后端 flag 守门（后端关 → 503 → 前端降级回退）
VITE_FEATURE_EVENT_CONNECTORS=false
