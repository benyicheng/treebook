// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

model MergeRequest {
  id              String    @id @default(uuid())
  type            String    @default("branch_merge") // branch_merge, spinoff_official
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId        String?
  spinoff         Spinoff?  @relation(fields: [spinoffId], references: [id], onDelete: Cascade)
  spinoffId       String?
  story           Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId         String
  status          String    @default("pending") // pending, approved, rejected
  message         String?   // 申请说明
  reviewComment   String?   // 审核回复
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("merge_requests")
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String          @unique
  passwordHash  String
  avatarUrl     String?
  profile       String?         // JSON string in SQLite
  role          String          @default("reader")
  roles         UserRole[]
  stories       Story[]
  branches      Branch[]
  spinoffs      Spinoff[]
  booklists     Booklist[]
  likes         Like[]
  ratings       Rating[]
  collaborations Collaboration[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  readingHistory ReadingHistory[]
  savepoints     ReadingSavepoint[]
  comments       Comment[]
  wallet         Wallet?
  transactions   Transaction[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  balance   Float    @default(0.0)
  currency  String   @default("UNIV") // Parallel Universe Coins
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amount      Float
  type        String   // REVENUE_SHARE, WITHDRAWAL, RECHARGE
  targetType  String?  // STORY, BRANCH
  targetId    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, type])
  @@map("transactions")
}

model ReadingSavepoint {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId   String
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId  String?
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String
  name      String?  // 自定义存档名
  createdAt DateTime @default(now())

  @@map("reading_savepoints")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model ReadingHistory {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  chapter            Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId          String
  progress           Float    @default(0) // 0-100 percentage
  referralBooklistId String?
  referralBooklist   Booklist? @relation("BooklistReferral", fields: [referralBooklistId], references: [id], onDelete: SetNull)
  readAt             DateTime @default(now())

  @@unique([userId, chapterId])
  @@index([referralBooklistId])
  @@index([chapterId])
  @@map("reading_history")
}

model Story {
  id          String    @id @default(uuid())
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  title       String
  description String?
  coverImage  String?
  status      String    @default("ongoing")
  metadata    String?   // JSON string
  viewCount   Int       @default(0)
  branchCount Int       @default(0)
  chapters    Chapter[]
  branches    Branch[]
  spinoffs    Spinoff[]
  collaborations Collaboration[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  characters  Character[]
  tags        Tag[]
  savepoints  ReadingSavepoint[]
  mergeRequests MergeRequest[]

  @@map("stories")
}

model Tag {
  id      String  @id @default(uuid())
  name    String  @unique
  stories Story[]

  @@map("tags")
}

model Character {
  id          String   @id @default(uuid())
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId     String
  name        String
  description String?
  avatarUrl   String?
  attributes  String?  // JSON string: e.g. { "strength": 10, "intelligence": 8 }
  role        String   @default("supporting") // protagonist, antagonist, supporting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("characters")
}

model Chapter {
  id             String    @id @default(uuid())
  story          Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId        String
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?
  title          String
  content        String
  orderIndex     Int
  isBranchPoint  Boolean   @default(false)
  characterData  String?   // JSON string
  branchesFrom   Branch[]  @relation("BranchSource")
  booklistItems  BooklistItem[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  readingHistory ReadingHistory[]
  savepoints     ReadingSavepoint[]
  comments       Comment[]

  @@map("chapters")
}

model Branch {
  id              String    @id @default(uuid())
  parentStory     Story     @relation(fields: [parentStoryId], references: [id], onDelete: Cascade)
  parentStoryId   String
  parentChapter   Chapter   @relation("BranchSource", fields: [parentChapterId], references: [id], onDelete: Cascade)
  parentChapterId String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  title           String
  description     String?
  branchType      String    @default("parallel")
  isOfficial      Boolean   @default(false)
  isCertified     Boolean   @default(false) // 是否被原作者认证为“金级分支”
  certifiedAt     DateTime?
  contributionScore Int     @default(0)    // 分支贡献度分值
  status          String    @default("ongoing") // ongoing, completed, merged
  conditions      String?   // JSON string
  viewCount       Int       @default(0)
  chapters        Chapter[]
  savepoints      ReadingSavepoint[]
  mergeRequests   MergeRequest[]
  spinoffs        Spinoff[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@map("branches")
}

model Spinoff {
  id                   String    @id @default(uuid())
  author               User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId             String
  originalStory        Story     @relation(fields: [originalStoryId], references: [id], onDelete: Cascade)
  originalStoryId      String
  originalBranch       Branch?   @relation(fields: [originalBranchId], references: [id], onDelete: SetNull)
  originalBranchId     String?
  title                String
  summary              String?   // 短简介
  content              String
  type                 String    @default("if_timeline") // biography, if_timeline, world_expansion
  status               String    @default("ongoing")     // ongoing, completed, merged
  isOfficial           Boolean   @default(false)
  revenueShareRate     Float     @default(0.1)           // 给原作者的分成比例，默认 10%
  referencedCharacters String?   // 引用的主线角色 ID 列表 (JSON String)
  characterRelationships String?   // JSON string
  viewCount            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  mergeRequests        MergeRequest[]

  @@index([originalStoryId])
  @@index([authorId])
  @@map("spinoffs")
}

model Booklist {
  id                 String           @id @default(uuid())
  creator            User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId          String
  title              String
  description        String?
  coverImage         String?          @default("https://images.unsplash.com/photo-1516979187457-637abb4f9353?auto=format&fit=crop&q=80&w=800")
  type               String           @default("COLLECTION") // COLLECTION or TIMELINE
  tags               String?          @default("") // Comma separated tags
  isPublic           Boolean          @default(true)
  isIncentiveEnabled Boolean          @default(true)
  totalEarnings      Float            @default(0.0)
  viewCount          Int              @default(0)
  likesCount         Int              @default(0)
  items              BooklistItem[]
  referralHistories  ReadingHistory[] @relation("BooklistReferral")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  @@index([creatorId])
  @@map("booklists")
}

model BooklistItem {
  id         String   @id @default(uuid())
  booklist   Booklist @relation(fields: [booklistId], references: [id], onDelete: Cascade)
  booklistId String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId  String
  orderIndex Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("booklist_items")
}

model Collaboration {
  id          String   @id @default(uuid())
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        String   @default("editor")
  permissions String?  // JSON string
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("collaborations")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., 'story:create'
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model UserRole {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model SiteConfig {
  id          String   @id @default(uuid())
  key         String   @unique  // e.g. "siteName", "logoUrl", "announcement"
  value       String   // JSON string or plain string
  updatedAt   DateTime @updatedAt

  @@map("site_configs")
}

model InteractionStat {
  id          String   @id @default(uuid())
  targetType  String
  targetId    String
  likeCount   Int      @default(0)
  ratingCount Int      @default(0)
  ratingSum   Int      @default(0)
  shareCount  Int      @default(0)
  viewCount   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([targetType, targetId])
  @@map("interaction_stats")
}

model Like {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("likes")
}

model Rating {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  targetType String
  targetId   String
  valueInt   Int
  reasonTags String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("ratings")
}
