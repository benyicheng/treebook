// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

model MergeRequest {
  id              String    @id @default(uuid())
  type            String    @default("branch_merge") // branch_merge, spinoff_official
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId        String?
  spinoff         Spinoff?  @relation(fields: [spinoffId], references: [id], onDelete: Cascade)
  spinoffId       String?
  story           Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId         String
  status          String    @default("pending") // pending, approved, rejected
  message         String?   // 申请说明
  reviewComment   String?   // 审核回复
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("merge_requests")
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Follow {
  id          String   @id @default(uuid())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Activity {
  id         String   @id @default(uuid())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId    String
  type       String   // story_publish, branch_create, spinoff_publish, chapter_update, merge_request, merge_approved
  targetType String   // story, branch, spinoff, chapter
  targetId   String
  metadata   String?  // JSON: { title, storyTitle, branchTitle, etc. }
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([type, createdAt])
  @@map("activities")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  actorId     String?
  type        String   // comment_reply | branch_created | merge_requested | merge_approved
  targetType  String   // comment | branch | merge_request
  targetId    String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String          @unique
  passwordHash  String
  avatarUrl     String?
  profile       String?         // JSON string in SQLite
  role          String          @default("reader")
  followerCount Int             @default(0)
  followingCount Int            @default(0)
  roles         UserRole[]
  stories       Story[]
  branches      Branch[]
  spinoffs      Spinoff[]
  booklists     Booklist[]
  likes         Like[]
  ratings       Rating[]
  collaborations Collaboration[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  readingHistory ReadingHistory[]
  savepoints     ReadingSavepoint[]
  comments       Comment[]
  booklistProgress BooklistProgress[]
  wallet         Wallet?
  transactions   Transaction[]
  followers      Follow[]       @relation("Following")
  following      Follow[]       @relation("Follower")
  activities     Activity[]
  readingPaths   ReadingPath[]
  readingTrails  ReadingTrail[]
  readingProgress ReadingProgress[]
  wikiPages      WikiPage[]    // 创建的百科页面
  refreshTokens  RefreshToken[] // JWT refresh tokens

  @@map("users")
}

/// 刷新令牌 — 用于 JWT access token 的无感续期
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

model Wallet {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  balance   Float    @default(0.0)
  currency  String   @default("UNIV") // Parallel Universe Coins
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amount      Float
  type        String   // REVENUE_SHARE, WITHDRAWAL, RECHARGE
  targetType  String?  // STORY, BRANCH
  targetId    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, type])
  @@map("transactions")
}

model ReadingSavepoint {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId   String
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId  String?
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String
  name      String?  // 自定义存档名
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([storyId])
  @@index([chapterId])
  @@map("reading_savepoints")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([authorId])
  @@map("comments")
}

model ReadingHistory {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  chapter            Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId          String
  progress           Float    @default(0) // 0-100 percentage
  referralBooklistId String?
  referralBooklist   Booklist? @relation("BooklistReferral", fields: [referralBooklistId], references: [id], onDelete: SetNull)
  readAt             DateTime @default(now())

  @@unique([userId, chapterId])
  @@index([referralBooklistId])
  @@index([chapterId])
  @@map("reading_history")
}

model Story {
  id          String    @id @default(uuid())
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  title       String
  description String?
  coverImage  String?
  status      String    @default("ongoing")
  metadata    String?   // JSON string
  viewCount   Int       @default(0)
  branchCount Int       @default(0)
  isOfficial  Boolean   @default(false)
  chapters    Chapter[]
  branches    Branch[]
  spinoffs    Spinoff[]
  collaborations Collaboration[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  characters  Character[]
  tags        Tag[]
  savepoints  ReadingSavepoint[]
  mergeRequests MergeRequest[]
  readingPaths ReadingPath[]
  wikiPages    WikiPage[]           // 该故事的百科页面
  booklistStoryLinks BooklistStoryLink[] // 该故事被哪些书单引用
  readingTrails ReadingTrail[]      // 该故事的阅读轨迹

  @@map("stories")
}

model Tag {
  id      String  @id @default(uuid())
  name    String  @unique
  stories Story[]

  @@map("tags")
}

model Character {
  id          String   @id @default(uuid())
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId     String
  name        String
  description String?
  avatarUrl   String?
  attributes  String?  // JSON string: e.g. { "strength": 10, "intelligence": 8 }
  role        String   @default("supporting") // protagonist, antagonist, supporting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  appearances CharacterAppearance[]

  @@map("characters")
}

/// 角色出场 — 多态关联到章节/分支/番外，用于阅读路径的角色导览
model CharacterAppearance {
  id             String   @id @default(uuid())
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId    String
  targetType     String   // 'chapter' | 'branch' | 'spinoff'
  targetId       String
  appearanceType String   @default("appears") // 'appears' | 'main_focus' | 'mention' | 'cameo'
  note           String?
  createdAt      DateTime @default(now())

  @@unique([characterId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("character_appearances")
}

/// 百科页面 — 人物/世界观/事件/概念的知识库
model WikiPage {
  id            String     @id @default(uuid())
  storyId       String?
  story         Story?     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  contentType   String     // 'character' | 'setting' | 'event' | 'concept' | 'faction' | 'item'
  content       String     // Markdown 正文
  summary       String?
  attributes    String?    // JSON: 结构化属性
  status        String     @default("published") // 'draft' | 'published' | 'archived'
  version       Int        @default(1)
  createdBy     String
  creator       User       @relation(fields: [createdBy], references: [id])
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())
  aliases       WikiAlias[]
  outgoingLinks WikiLink[] @relation("OutgoingLinks")
  incomingLinks WikiLink[] @relation("IncomingLinks")

  @@unique([storyId, slug])
  @@map("wiki_pages")
}

/// 百科别名 — 支持多语言/曾用名搜索
model WikiAlias {
  id         String   @id @default(uuid())
  wikiPageId String
  wikiPage   WikiPage @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)
  alias      String
  language   String?

  @@index([alias])
  @@map("wiki_aliases")
}

/// 百科内部链接 — 双向引用
model WikiLink {
  id           String   @id @default(uuid())
  sourcePageId String
  sourcePage   WikiPage @relation("OutgoingLinks", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPageId String
  targetPage   WikiPage @relation("IncomingLinks", fields: [targetPageId], references: [id], onDelete: Cascade)
  linkType     String   // 'reference' | 'see_also' | 'parent' | 'child' | 'related'

  @@unique([sourcePageId, targetPageId, linkType])
  @@map("wiki_links")
}

model Chapter {
  id             String    @id @default(uuid())
  story          Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId        String
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?
  title          String
  content        String
  orderIndex     Int
  isBranchPoint  Boolean   @default(false)
  characterData  String?   // JSON string
  branchesFrom   Branch[]  @relation("BranchSource")
  booklistItems  BooklistItem[]
  spinoffs       Spinoff[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  readingHistory ReadingHistory[]
  savepoints     ReadingSavepoint[]
  readingProgress ReadingProgress[]
  comments       Comment[]

  @@index([branchId])
  @@index([storyId, orderIndex])
  @@map("chapters")
}

model Branch {
  id              String    @id @default(uuid())
  parentStory     Story     @relation(fields: [parentStoryId], references: [id], onDelete: Cascade)
  parentStoryId   String
  parentChapter   Chapter   @relation("BranchSource", fields: [parentChapterId], references: [id], onDelete: Cascade)
  parentChapterId String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  title           String
  description     String?
  branchType      String    @default("parallel")
  isOfficial      Boolean   @default(false)
  isCertified     Boolean   @default(false) // 是否被原作者认证为“金级分支”
  certifiedAt     DateTime?
  contributionScore Int     @default(0)    // 分支贡献度分值
  status          String    @default("ongoing") // ongoing, completed, merged
  conditions      String?   // JSON string
  viewCount       Int       @default(0)
  chapters        Chapter[]
  savepoints      ReadingSavepoint[]
  mergeRequests   MergeRequest[]
  spinoffs        Spinoff[]
  parentBranchId  String?           // 父分支（子分支用）
  parentBranch    Branch?           @relation("SubBranch", fields: [parentBranchId], references: [id])
  subBranches     Branch[]          @relation("SubBranch")
  treeDepth       Int               @default(0)  // 0=直接来自主线, 1=子分支, 2=子子分支...
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([authorId])
  @@index([parentStoryId])
  @@index([parentChapterId])
  @@map("branches")
}

model Spinoff {
  id                   String    @id @default(uuid())
  author               User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId             String
  originalStory        Story     @relation(fields: [originalStoryId], references: [id], onDelete: Cascade)
  originalStoryId      String
  originalBranch       Branch?   @relation(fields: [originalBranchId], references: [id], onDelete: SetNull)
  originalBranchId     String?
  originalChapter      Chapter?  @relation(fields: [originalChapterId], references: [id], onDelete: SetNull)
  originalChapterId    String?
  title                String
  summary              String?   // 短简介
  content              String
  type                 String    @default("if_timeline") // biography, if_timeline, world_expansion
  status               String    @default("ongoing")     // ongoing, completed, merged
  isOfficial           Boolean   @default(false)
  revenueShareRate     Float     @default(0.1)           // 给原作者的分成比例，默认 10%
  referencedCharacters String?   // 引用的主线角色 ID 列表 (JSON String)
  characterRelationships String?   // JSON string
  viewCount            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  mergeRequests        MergeRequest[]

  @@index([originalStoryId])
  @@index([authorId])
  @@index([originalBranchId])
  @@index([originalChapterId])
  @@map("spinoffs")
}

model Booklist {
  id                 String           @id @default(uuid())
  creator            User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId          String
  title              String
  description        String?
  coverImage         String?          @default("https://images.unsplash.com/photo-1516979187457-637abb4f9353?auto=format&fit=crop&q=80&w=800")
  type               String           @default("COLLECTION") // COLLECTION or TIMELINE
  tags               String?          @default("") // Comma separated tags
  isPublic           Boolean          @default(true)
  isIncentiveEnabled Boolean          @default(true)
  totalEarnings      Float            @default(0.0)
  viewCount          Int              @default(0)
  likesCount         Int              @default(0)
  items              BooklistItem[]
  progress           BooklistProgress[]
  referralHistories  ReadingHistory[] @relation("BooklistReferral")
  linkedStories      BooklistStoryLink[] // 书单涉及的故事（反向索引）
  paths              ReadingPath[]       // 基于本书单的阅读路径
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  @@index([creatorId])
  @@map("booklists")
}

model BooklistProgress {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  booklist          Booklist @relation(fields: [booklistId], references: [id], onDelete: Cascade)
  booklistId        String
  currentItemIndex  Int      @default(-1)
  completedItemIds  String   @default("[]") // JSON array of completed item IDs
  updatedAt         DateTime @updatedAt

  @@unique([userId, booklistId])
  @@map("booklist_progress")
}

model BooklistItem {
  id         String    @id @default(uuid())
  booklist   Booklist  @relation(fields: [booklistId], references: [id], onDelete: Cascade)
  booklistId String
  targetType String?   // 'story' | 'branch' | 'spinoff' | 'chapter' | 'character' | 'wiki_page'
  targetId   String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chapterId  String?
  orderIndex Int
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  outgoingEdges BooklistItemRelation[] @relation("OutgoingEdges")
  incomingEdges BooklistItemRelation[] @relation("IncomingEdges")

  @@index([booklistId])
  @@index([targetType, targetId])
  @@map("booklist_items")
}

/// 书单关系边 — 将书单从列表升格为关系图
model BooklistItemRelation {
  id              String       @id @default(uuid())
  sourceItemId    String
  sourceItem      BooklistItem @relation("OutgoingEdges", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItemId    String
  targetItem      BooklistItem @relation("IncomingEdges", fields: [targetItemId], references: [id], onDelete: Cascade)
  relationType    String       // SAME_CHARACTER | ALTERNATE_INTERPRETATION | SHARED_UNIVERSE | TIMELINE_FORK | PARALLEL_EVENT | PRECEDING_EVENT | CHARACTER_CAMEO | BACKGROUND_REFERENCE
  label           String?
  createdAt       DateTime     @default(now())

  @@unique([sourceItemId, targetItemId, relationType])
  @@map("booklist_item_relations")
}

/// 书单-故事关联索引 — 解决"故事不知道被哪些书单引用"
model BooklistStoryLink {
  id          String   @id @default(uuid())
  booklistId  String
  booklist    Booklist @relation(fields: [booklistId], references: [id], onDelete: Cascade)
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  relation    String   // 'featured' | 'referenced' | 'comparison'
  createdAt   DateTime @default(now())

  @@unique([booklistId, storyId])
  @@map("booklist_story_links")
}

model Collaboration {
  id          String   @id @default(uuid())
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        String   @default("editor")
  permissions String?  // JSON string
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("collaborations")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., 'story:create'
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model UserRole {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model SiteConfig {
  id          String   @id @default(uuid())
  key         String   @unique  // e.g. "siteName", "logoUrl", "announcement"
  value       String   // JSON string or plain string
  updatedAt   DateTime @updatedAt

  @@map("site_configs")
}

model InteractionStat {
  id          String   @id @default(uuid())
  targetType  String
  targetId    String
  likeCount   Int      @default(0)
  ratingCount Int      @default(0)
  ratingSum   Int      @default(0)
  shareCount  Int      @default(0)
  viewCount   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([targetType, targetId])
  @@map("interaction_stats")
}

model Like {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
  @@map("likes")
}

model Rating {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  targetType String
  targetId   String
  valueInt   Int
  reasonTags String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
  @@map("ratings")
}

model InteractionEvent {
  id        String   @id @default(uuid())
  type      String
  targetType String
  targetId  String
  userId    String?
  platform  String?
  score     Float?
  reasonTags String?
  traceId   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("interaction_events")
}

model ModerationJob {
  id        String   @id @default(uuid())
  status    String
  request   String
  attempts  Int      @default(0)
  nextRunAt DateTime?
  lockedAt  DateTime?
  lockedBy  String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status, nextRunAt])
  @@index([createdAt])
  @@map("moderation_jobs")
}

model ModerationDecision {
  id          String   @id @default(uuid())
  jobId       String
  businessLine String
  targetType  String
  targetId    String
  contentType String
  field       String?
  status      String
  labels      String
  reasons     String
  score       Float?
  provider    String?
  traceId     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([status])
  @@index([jobId])
  @@map("moderation_decisions")
}

model ModerationAuditLog {
  id          String   @id @default(uuid())
  action      String
  actorUserId String?
  targetType  String
  targetId    String
  decisionId  String?
  payload     String?
  traceId     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("moderation_audit_logs")
}

model ModerationCase {
  id               String   @id @default(uuid())
  businessLine     String
  targetType       String
  targetId         String
  contentType      String
  field            String?
  status           String
  level            Int      @default(1)
  assigneeUserId   String?
  sourceDecisionId String?
  snapshot         String?
  dueAt            DateTime?
  reopenedCount    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  actions          ModerationCaseAction[]

  @@index([targetType, targetId])
  @@index([status, updatedAt])
  @@map("moderation_cases")
}

model EditorialChange {
  id          String   @id @default(uuid())
  targetType  String
  targetId    String
  field       String
  status      String
  original    String?
  proposed    String
  appliedBy   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions     EditorialChangeAction[]

  @@index([targetType, targetId])
  @@index([status, updatedAt])
  @@map("editorial_changes")
}

model EditorialChangeAction {
  id          String   @id @default(uuid())
  change      EditorialChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  changeId    String
  action      String
  actorUserId String?
  payload     String?
  createdAt   DateTime @default(now())

  @@index([changeId, createdAt])
  @@map("editorial_change_actions")
}

model ModerationCaseAction {
  id          String   @id @default(uuid())
  case        ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  action      String
  actorUserId String?
  payload     String?
  createdAt   DateTime @default(now())

  @@index([caseId, createdAt])
  @@map("moderation_case_actions")
}

model MediaAsset {
  id              String   @id @default(uuid())
  ownerUserId     String?
  purpose         String?
  originalName    String
  mimeType        String
  sizeBytes       Int
  sha256          String
  storageProvider String
  storagePath     String
  status          String
  width           Int?
  height          Int?
  durationMs      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  riskLogs        MediaRiskLog[]

  @@index([ownerUserId, createdAt])
  @@index([status, updatedAt])
  @@index([sha256])
  @@map("media_assets")
}

model MediaRiskLog {
  id        String   @id @default(uuid())
  asset     MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId   String?
  kind      String
  severity  String
  message   String
  payload   String?
  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
  @@map("media_risk_logs")
}

/// 阅读路径 — 用户创建的阅读顺序导航
model ReadingPath {
  id              String      @id @default(uuid())
  storyId         String?     // 可选：跨作品路径不需要绑定单一故事
  story           Story?      @relation(fields: [storyId], references: [id], onDelete: SetNull)
  creatorId       String
  creator         User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  origin          String      @default("community")  // 'author' | 'community' | 'system'
  booklistId      String?     // 所属书单（路径是对书单关系的阅读实现）
  booklist        Booklist?   @relation(fields: [booklistId], references: [id], onDelete: SetNull)
  status          String      @default("published")  // 'draft' | 'published'
  viewCount       Int         @default(0)
  startCount      Int         @default(0)
  completionCount Int         @default(0)
  avgDurationMin  Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  nodes           ReadingPathNode[]
  trails          ReadingTrail[]

  @@index([storyId, viewCount])
  @@index([creatorId])
  @@map("reading_paths")
}

/// 路径节点 — 有序序列，contentId 为多态外键
model ReadingPathNode {
  id            String        @id @default(uuid())
  path          ReadingPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  pathId        String
  sortOrder     Int
  nodeCategory  String        // 'chapter' | 'branch' | 'spinoff'
  contentId     String
  storyId       String?       // 内容所属故事ID（支持跨作品，可选以兼容存量数据）
  storyTitle    String?       // 显示用冗余
  contentTitle  String?
  note          String?
  estimatedMin  Int?

  @@index([pathId, sortOrder])
  @@map("reading_path_nodes")
}

/// 阅读轨迹 — 用户在某路径上的进度
model ReadingTrail {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathId          String?
  path            ReadingPath? @relation(fields: [pathId], references: [id], onDelete: SetNull)
  storyId         String?      // 可选：跨作品路径不需要绑定单一故事
  story           Story?       @relation(fields: [storyId], references: [id], onDelete: SetNull)
  currentNodeId   String?
  currentNodeIndex Int         @default(-1)
  trailNodes      String       @default("[]")  // JSON array
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  durationMin     Int?

  @@index([userId, storyId])
  @@index([pathId])
  @@index([currentNodeId])
  @@map("reading_trails")
}

/// 统一阅读进度 — 跨书单/阅读路径/Wiki 共享，以 chapterId 为唯一键
model ReadingProgress {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId      String
  source         String?   // 'booklist' | 'readingpath' | 'wiki' — 辅助上下文，记录最后一次来自哪里
  sourceId       String?   // 对应的 booklist/readingpath/wiki ID
  status         String    @default("reading") // 'reading' | 'completed'
  progress       Float     @default(0)         // 0-100 百分比
  currentPage    Int?      // 分页内容的当前页
  updatedAt      DateTime  @updatedAt

  @@unique([userId, chapterId])
  @@index([userId, status])
  @@index([chapterId])
  @@map("reading_progress")
}
